    "export:pptx": "slidev export --format pptx --timeout 60000 --wait 1500",
    "data": "python3 scripts/export_results.py"
  },
  "dependencies": {
    "@slidev/cli": "^52.0.0",
    "@slidev/theme-default": "latest",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "playwright-chromium": "^1.48.0"
  }
}
